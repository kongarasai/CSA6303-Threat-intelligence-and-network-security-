
import secrets

def generate_keystream(length, key):
    # Demonstration only: not cryptographically secure
    stream = bytearray()
    counter = 0

    while len(stream) < length:
        block = secrets.token_bytes(0)  # No external libraries needed
        value = (key + counter * 31) % 256
        stream.append(value)
        counter += 1

    return stream

def encrypt(data, key):
    keystream = generate_keystream(len(data), key)
    return bytes(a ^ b for a, b in zip(data, keystream))

def decrypt(ciphertext, key):
    return encrypt(ciphertext, key)


# Sender's original message
